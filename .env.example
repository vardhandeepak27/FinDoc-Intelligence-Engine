# Copy this file to .env and fill in your values.
# .env is git-ignored; .env.example is committed so others know what to set.
# Every variable uses the FINDOC_ prefix. Anything left out falls back to the
# default in src/config.py.

# --- LLM ---
FINDOC_LLM_PROVIDER=groq
FINDOC_GROQ_API_KEY=
FINDOC_GEMINI_API_KEY=

# --- Logging ---
FINDOC_LOG_LEVEL=INFO

# --- Optional overrides (defaults live in config.py) ---
# FINDOC_DATA_DIR=data
# FINDOC_INDEX_DIR=indexes
# FINDOC_CHUNK_SIZE=1200
# FINDOC_CHUNK_OVERLAP=150
# FINDOC_EMBEDDING_MODEL=all-MiniLM-L6-v2
# FINDOC_TOP_K=10
